# Devin Investment OS API Keys Template
# Copy this file to:
# secrets/api_keys.local.env
#
# Fill in values locally.
# Never commit api_keys.local.env to GitHub.

# =========================
# IBKR Read-only
# =========================
IBKR_ENABLED=false
IBKR_API_MODE=webapi
IBKR_ACCOUNT_ID=
IBKR_GATEWAY_URL=http://127.0.0.1:5000
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# =========================
# Yuanta SparkAPI Read-only
# =========================
YUANTA_ENABLED=false
YUANTA_MODE=local_bridge
YUANTA_ACCOUNT=
YUANTA_LOGIN_ID=
YUANTA_LOGIN_PASSWORD=
YUANTA_CERT_PATH=
YUANTA_CERT_PASSWORD=
YUANTA_DLL_DIR=
YUANTA_QUOTE_JSON_PATH=data/yuanta_quotes.json
YUANTA_POSITION_JSON_PATH=data/yuanta_positions.json

# =========================
# Binance Read-only
# =========================
BINANCE_ENABLED=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com

# =========================
# OKX Read-only
# =========================
OKX_ENABLED=false
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com

# =========================
# Bitget Read-only
# =========================
BITGET_ENABLED=false
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_BASE_URL=https://api.bitget.com

# =========================
# TradingView Webhook
# =========================
TRADINGVIEW_ENABLED=false
TRADINGVIEW_WEBHOOK_SECRET=

# =========================
# Telegram Notifications
# =========================
TELEGRAM_ENABLED=false
